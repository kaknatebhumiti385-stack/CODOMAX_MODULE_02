
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowReadS3Objects",
            "Effect": "Allow",
            "Action": ["s3:GetObject"],
            "Resource": [
                "arn:aws:s3:::codomax-demo-bucket/*"
            ]
        },
        {
            "Sid": "AllowListBucket",
            "Effect": "Allow",
            "Action": ["s3:ListBucket"],
            "Resource": [
                "arn:aws:s3:::codomax-demo-bucket"
            ]
        },
        {
            "Sid": "DenyDeleteObjects",
            "Effect": "Deny",
            "Action": ["s3:DeleteObject"],
            "Resource": [
                "arn:aws:s3:::codomax-demo-bucket/*"
            ]
        }
    ]
}
